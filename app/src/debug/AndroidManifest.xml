<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-driven receiver. Lets `adb shell am broadcast` invoke iCloud
             Notes operations (list / lookup / append) without going through
             the UI. Enables closed-loop testing alongside the `memo` CLI.
             Debug builds only, and only for senders holding DUMP (adb shell
             does; ordinary apps do not), since the actions can rewrite and
             delete notes. -->
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.example.applenotes.LIST" />
                <action android:name="com.example.applenotes.LOOKUP" />
                <action android:name="com.example.applenotes.LOOKUP_BY_TITLE" />
                <action android:name="com.example.applenotes.APPEND" />
                <action android:name="com.example.applenotes.APPEND_BY_TITLE" />
                <action android:name="com.example.applenotes.SET_BODY_BY_TITLE" />
                <action android:name="com.example.applenotes.DELETE_BY_TITLE" />
                <action android:name="com.example.applenotes.DUMP_BY_TITLE" />
                <action android:name="com.example.applenotes.DUMP_RECORD" />
                <action android:name="com.example.applenotes.CREATE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
